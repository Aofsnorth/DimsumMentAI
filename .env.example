# API keys for DimsumMentAI.
# Copy this file to `.env` (in the project root, next to configs/) and fill in
# your keys. `.env` is gitignored — never commit real keys.
#
# The key used by the bot depends on the `ai.provider` setting in configs/bot.yaml:
#   nvidia            -> NVIDIA_API_KEY
#   openai_compatible -> OPENAI_API_KEY
#
# The .env file is auto-loaded on startup by the config loader (godotenv).
# Existing shell env vars always take precedence over .env values.

NVIDIA_API_KEY=
OPENAI_API_KEY=

# TypeSafe AI (Jev) — the System One decision model used by the AGI reflex
# layer (agi.jev.enabled in configs/bot.yaml). Leave empty to run without it;
# the bot then falls back to its built-in thresholds.
# Get a key: console.typesafe.ai (may be waitlisted). Free alternatives are the
# Vercel AI Gateway and OpenRouter — see agi.jev in configs/bot.yaml.
TYPESAFE_API_KEY=

# Override the Jev model alias. Leave as jev-latest to always get the current
# release; pin a number (e.g. jev-1.13.0) for reproducible behaviour.
JEV_MODEL=jev-latest
