+				return
+			}
+			_ = b.WritePacket(&packet.Animate{
+				ActionType:      packet.AnimateActionSwingArm,
+				EntityRuntimeID: b.GetEntityRuntimeID(),
+			})
+			time.Sleep(interval)
+		}
+	}()
+}
